# Entorno común del robot. Uso:  source ~/amr_ws/src/AMR_master/amr_bringup/config/amr.env
source /opt/ros/jazzy/setup.bash
[ -f "$HOME/amr_ws/install/setup.bash" ] && source "$HOME/amr_ws/install/setup.bash"
export ROS_DOMAIN_ID=3
# SUBNET permite RViz desde una laptop en la misma red; LOCALHOST aísla la NUC.
export ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET
export RCUTILS_COLORIZED_OUTPUT=1
