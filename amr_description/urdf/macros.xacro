<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="omr_grey"><color rgba="0.35 0.35 0.38 1.0"/></material>
  <material name="omr_dark"><color rgba="0.10 0.10 0.10 1.0"/></material>
  <material name="omr_orange"><color rgba="0.95 0.45 0.10 1.0"/></material>
  <material name="omr_blue"><color rgba="0.15 0.35 0.75 1.0"/></material>

  <xacro:macro name="box_inertia" params="m x y z">
    <inertia ixx="${m * (y*y + z*z) / 12.0}" ixy="0" ixz="0"
             iyy="${m * (x*x + z*z) / 12.0}" iyz="0"
             izz="${m * (x*x + y*y) / 12.0}"/>
  </xacro:macro>

  <!-- Cilindro con el eje a lo largo de z local. -->
  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertia ixx="${m * (3*r*r + h*h) / 12.0}" ixy="0" ixz="0"
             iyy="${m * (3*r*r + h*h) / 12.0}" iyz="0"
             izz="${m * r * r / 2.0}"/>
  </xacro:macro>
</robot>
