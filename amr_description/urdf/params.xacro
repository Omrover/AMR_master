<?xml version="1.0"?>
<!--
  Parámetros geométricos del Mobile Manipulator.
  Valores marcados TBD son provisionales: sustituir con las medidas reales
  (o con el export de SolidWorks) sin cambiar los nombres de frames.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================== Base omnidireccional (X a 45 deg) ===================== -->
  <!-- Del CAD (AMR_URDF, 2026-11-25): el chasis va de x -0.330 a +0.345 (con la torre
       del LiDAR), y +-0.222, z 0.036..0.260 desde el piso; cubierta a ~0.20 m.
       Mallas en meshes/base (origen del CAD = piso = base_footprint). -->
  <xacro:property name="base_length" value="0.675"/>
  <xacro:property name="base_width" value="0.444"/>
  <xacro:property name="base_height" value="0.224"/>
  <xacro:property name="base_mass" value="9.0"/>
  <xacro:property name="wheel_radius" value="0.0762"/>       <!-- rueda mecanum de 6" -->
  <xacro:property name="wheel_width" value="0.063"/>
  <xacro:property name="wheel_mass" value="1.5"/>
  <!-- Centro de cada rueda en (+-wheel_x, +-wheel_y) respecto al centro del robot y a
       wheel_z_cad del piso (CAD). El firmware usa 0.1583/0.1734 (x/y intercambiados);
       la cinemática mecanum solo usa la suma (0.3325 vs 0.3317), así que no cambia. -->
  <xacro:property name="wheel_x" value="0.1734"/>
  <xacro:property name="wheel_y" value="0.15913"/>
  <xacro:property name="wheel_z_cad" value="0.07574"/>
  <!-- Deben coincidir con half_length/half_width del firmware (amr_drive),
       gz_mcu y mcu_emulator. Brazo de palanca de wz: wheel_x + wheel_y. -->

  <!-- ===================== Sensores ===================== -->
  <!-- RPLIDAR A1M8 -->
  <!-- Medido en el robot (2026-11-23) desde el centro de la base a nivel de piso:
       x 0.3042, y 0, z 0.24936. base_link está a wheel_radius del piso.
       lidar_yaw: giro del A1 respecto al frente del robot. Verificar con una caja
       al frente y RViz en base_link: debe salir en +x. Si sale a la izquierda (+y)
       restar pi/2; a la derecha (-y) sumar pi/2; atrás, pi. El filtro del brazo
       (scan_self_filter) usa la TF, así que se corrige junto con esto. -->
  <xacro:property name="lidar_x" value="0.3042"/>
  <xacro:property name="lidar_y" value="0.0"/>
  <xacro:property name="lidar_z" value="${0.24936 - wheel_radius}"/>
  <!-- 2026-11-23: el 0° del A1 apunta a la izquierda del robot (+y). -->
  <xacro:property name="lidar_yaw" value="${pi/2}"/>
  <!-- BNO080 -->
  <xacro:property name="imu_x" value="0.0"/>                 <!-- CAD: IMU_joint -->
  <xacro:property name="imu_y" value="0.0"/>
  <xacro:property name="imu_z" value="${0.18086 - wheel_radius}"/>

  <!-- ===================== Brazo 4 DOF (CAD Brazo_4GDL_URDF_v4) ===================== -->
  <!-- Cadena y mallas del CAD (meshes/arm). Las juntas usan la convención de la tabla
       DH de AMR_arm (la de la calibración, arm_sign y las poses guardadas):
       q_CAD = (q1 - pi, -q2, -q3, q4). arm_base_link = base_link del CAD (0.0204 m bajo
       la cara superior de la base del brazo, 0.0675 m sobre su apoyo). -->
  <xacro:property name="arm_j1_z" value="0.02045"/>          <!-- arm_base_link -> junta 1 -->
  <xacro:property name="arm_j2_z" value="0.0772"/>           <!-- junta 1 -> hombro -->
  <xacro:property name="arm_l1" value="${arm_j1_z + arm_j2_z}"/>
  <xacro:property name="arm_l2" value="0.4"/>
  <xacro:property name="arm_l3" value="0.095"/>
  <xacro:property name="arm_l4" value="0.24525"/>
  <xacro:property name="arm_C" value="${sqrt(arm_l3**2 + arm_l4**2)}"/>
  <xacro:property name="arm_phi" value="${acos(arm_l4 / arm_C)}"/>
  <xacro:property name="arm_gamma" value="${pi + arm_phi}"/>
  <!-- tool0 (raíz de los dedos) en arm_link_4 del CAD; x = hacia los dedos. -->
  <xacro:property name="tool0_x" value="-0.17479"/>
  <xacro:property name="tool0_y" value="-0.05323"/>
  <xacro:property name="tool0_yaw" value="-2.772"/>
  <!-- Montaje del brazo sobre la base (el URDF del AMR no lo trae). El origen del CAD
       del brazo es la cara inferior de su placa (10 x 16.6 cm); la placa se apoya en el
       techo del chasis (cara superior de la malla a 0.196 m del piso) y el motor de q1
       queda dentro del chasis. y = 0 del CAD (centrado a lo ancho). x medido en el robot
       (2026-11-27): eje de q1 a 0.1194 m al frente del centro del robot (el CAD daba
       0.1394; con ese valor el TCP medido quedaba 2 cm atrás de la TF). -->
  <xacro:property name="arm_mount_x" value="0.1194"/>
  <xacro:property name="arm_mount_y" value="0.0"/>
  <xacro:property name="arm_mount_z" value="${0.196 - wheel_radius}"/>
  <xacro:property name="arm_mount_yaw" value="0.0"/>
  <!-- Límites (rad) en la convención DH. Del CAD (q2 en [-0.1, 3.49], q3 en [-3.49, 0],
       q4 en [-1.22, 1.57]) con dos ajustes por el robot real: q2 >= -0.06 (el tope
       físico está en arm_ref_pose q2 = -0.059) y q3 hasta 0.1 (rest y la referencia
       de calibración quedan en q3 = 0 y -0.029). Igual que arm_lower/arm_upper de arm.yaml. -->
  <!-- q1: el CAD da [-pi, pi] alrededor de SU cero, que es nuestro pi (rest, el brazo
       doblado hacia atrás): en la convención DH es [0, 2 pi], +-180 grados desde rest.
       Así rest y los agarres por encima (q1 = pi) quedan a la mitad del recorrido. -->
  <xacro:property name="arm_q1_min" value="0.0"/>
  <xacro:property name="arm_q1_max" value="${2*pi}"/>
  <xacro:property name="arm_q2_min" value="-0.06"/>
  <xacro:property name="arm_q2_max" value="3.4907"/>
  <xacro:property name="arm_q3_min" value="-3.4907"/>
  <xacro:property name="arm_q3_max" value="0.1"/>
  <xacro:property name="arm_q4_min" value="-1.2217"/>
  <xacro:property name="arm_q4_max" value="1.5708"/>
  <xacro:property name="arm_effort" value="11.0"/>           <!-- N·m pico GIM6010-8 -->
  <xacro:property name="arm_velocity" value="3.0"/>          <!-- rad/s, TBD -->

  <!-- ===================== Gripper (motor DC + DRV8833) ===================== -->
  <!-- Dedos del CAD (link_gl / link_gr): con 0 se tocan; abren hasta 0.05 m cada uno.
       gripper_tcp: punto de agarre a lo largo de los dedos desde su raíz (TBD). -->
  <xacro:property name="gripper_finger_travel" value="0.05"/>
  <xacro:property name="gripper_finger_left_z" value="0.030271"/>
  <xacro:property name="gripper_finger_right_z" value="-0.028681"/>
  <xacro:property name="gripper_tcp_x" value="0.05"/>

  <!-- ===================== Cámara eye-in-hand (Orbbec DaBai DCW) ===================== -->
  <!-- camera_mount_link = link_camera del CAD en arm_link_4. camera_link (REP-103,
       x = eje óptico) se supone mirando hacia donde apuntan los dedos (z del CAD):
       verificar en RViz con la malla; la pose real sale de la calibración hand-eye. -->
  <xacro:property name="camera_mount_xyz" value="-0.10219 -0.0029905 0.000795"/>
  <xacro:property name="camera_mount_rpy" value="0.34 -1.5708 0"/>
  <xacro:property name="camera_link_rpy" value="0 ${-pi/2} 0"/>

  <!-- ===================== Bandeja de carga ===================== -->
  <xacro:property name="tray_x" value="-0.12"/>              <!-- TBD -->
  <xacro:property name="tray_z" value="${0.198 + 0.005 - wheel_radius}"/>  <!-- sobre la cubierta (CAD) -->
</robot>
