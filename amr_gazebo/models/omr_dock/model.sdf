<?xml version="1.0"?>
<!--
  Dock dummy del Mobile Manipulator: panel de 0.6 m de alto con un AprilTag
  36h11 id 0 (10 cm de cuadro negro, 14 cm con el margen blanco). El tag mira
  hacia +x del modelo y su centro está a 0.38 m, la altura de la cámara con el
  brazo en la postura dock_view. Para el robot real se imprime
  materials/textures/tag36h11_0.png a 14 x 14 cm.
-->
<sdf version="1.9">
  <model name="omr_dock">
    <static>true</static>
    <link name="link">
      <collision name="panel">
        <pose>0 0 0.3 0 0 0</pose>
        <geometry><box><size>0.05 0.5 0.6</size></box></geometry>
      </collision>
      <visual name="panel">
        <pose>0 0 0.3 0 0 0</pose>
        <geometry><box><size>0.05 0.5 0.6</size></box></geometry>
        <material>
          <ambient>0.95 0.8 0.1 1</ambient>
          <diffuse>0.95 0.8 0.1 1</diffuse>
        </material>
      </visual>
      <visual name="tag">
        <!-- Malla con UV explícitas: con <box> Gazebo mapea solo una fracción de la
             textura en cada cara (el tag salía de ~2 cm) y con <plane> la repite por
             metro (solo se veía el margen blanco). -->
        <pose>0.0256 0 0.38 0 0 0</pose>
        <geometry><mesh><uri>model://omr_dock/meshes/tag.obj</uri></mesh></geometry>
      </visual>
    </link>
  </model>
</sdf>
