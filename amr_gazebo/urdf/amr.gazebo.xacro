<?xml version="1.0"?>
<!--
  Plugins y sensores de Gazebo Harmonic (gz-sim 8). Los topics gz se puentean
  con config/ros_gz_bridge.yaml y los consume gz_mcu (el "MCU" simulado), que
  habla el contrato MQTT v1 con el bridge real. Así, en simulación corre la
  misma pila que en el robot.

  Base: holonómica cinemática con VelocityControl. Simular los rodillos de las
  ruedas omni físicamente es inestable, así que las ruedas no tienen fricción y
  sus ángulos se calculan con la cinemática a partir de la velocidad medida.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Ruedas sin fricción: la base se mueve por VelocityControl. -->
  <xacro:macro name="frictionless" params="link">
    <gazebo reference="${link}">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
    </gazebo>
  </xacro:macro>
  <xacro:frictionless link="wheel_fl_link"/>
  <xacro:frictionless link="wheel_rl_link"/>
  <xacro:frictionless link="wheel_rr_link"/>
  <xacro:frictionless link="wheel_fr_link"/>

  <xacro:macro name="position_controller" params="joint">
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>${joint}</joint_name>
      <topic>/sim/${joint}/cmd_pos</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <cmd_max>3.0</cmd_max>
      <cmd_min>-3.0</cmd_min>
      <p_gain>40</p_gain>
      <i_gain>0.5</i_gain>
      <d_gain>2</d_gain>
    </plugin>
  </xacro:macro>

  <gazebo>
    <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
      <topic>/sim/cmd_vel</topic>
    </plugin>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_topic>/sim/odom</odom_topic>
      <tf_topic>/sim/odom_tf</tf_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
      <dimensions>2</dimensions>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/sim/joint_states</topic>
      <update_rate>50</update_rate>
    </plugin>
    <xacro:position_controller joint="arm_joint_1"/>
    <xacro:position_controller joint="arm_joint_2"/>
    <xacro:position_controller joint="arm_joint_3"/>
    <xacro:position_controller joint="arm_joint_4"/>
    <xacro:position_controller joint="gripper_finger_joint"/>
    <xacro:position_controller joint="gripper_finger_right_joint"/>
  </gazebo>

  <!-- RPLIDAR A1M8: 360 muestras, 0.15-12 m, ~8 Hz -->
  <gazebo reference="laser_link">
    <sensor name="rplidar_a1" type="gpu_lidar">
      <gz_frame_id>laser_link</gz_frame_id>
      <topic>/scan</topic>
      <update_rate>8</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- BNO080 (el contrato envía cuaternión, gyro y accel) -->
  <gazebo reference="imu_link">
    <sensor name="bno080" type="imu">
      <gz_frame_id>imu_link</gz_frame_id>
      <topic>/sim/imu</topic>
      <update_rate>100</update_rate>
      <always_on>true</always_on>
      <imu>
        <angular_velocity>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- RealSense D435i (RGB-D), mira a lo largo de x de camera_link -->
  <gazebo reference="camera_link">
    <sensor name="d435i" type="rgbd_camera">
      <gz_frame_id>camera_color_optical_frame</gz_frame_id>
      <topic>/camera</topic>
      <update_rate>15</update_rate>
      <always_on>true</always_on>
      <camera>
        <horizontal_fov>1.204</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
        <depth_camera>
          <clip>
            <near>0.1</near>
            <far>10.0</far>
          </clip>
        </depth_camera>
      </camera>
    </sensor>
  </gazebo>
</robot>
